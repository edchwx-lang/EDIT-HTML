{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edit-html-report.local/schemas/v4/presentation-plan.schema.json",
  "title": "Huashu Presentation Plan",
  "type": "object",
  "required": ["schemaVersion", "variantId", "mode", "generatedBy", "designInputSha256", "designOutputSha256", "contentMutationAllowed", "bindings"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "variantId": { "type": "string" },
    "mode": { "enum": ["data-first", "evidence-first"] },
    "generatedBy": { "const": "huashu-design-package-compiler" },
    "huashuRunId": { "type": "string", "minLength": 1 },
    "designInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "designOutputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentMutationAllowed": { "const": false },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "componentId", "layoutId", "interactionIds", "packageClass", "primitive"],
        "not": { "anyOf": [{ "required": ["text"] }, { "required": ["value"] }, { "required": ["sourceRefs"] }] }
      }
    }
  },
  "additionalProperties": true
}
