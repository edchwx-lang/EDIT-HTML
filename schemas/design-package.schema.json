{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edit-html-report.local/schemas/v4.3/design-package.schema.json",
  "title": "Complete Huashu Strategy Candidate Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageVersion",
    "candidateId",
    "designDirectionId",
    "designDirectionLabel",
    "strategyThesis",
    "previewThemeId",
    "showcaseSha256",
    "inputSha256",
    "outputSha256",
    "compositionSha256",
    "componentTreeSha256",
    "huashuRunId",
    "huashuInvokedAt",
    "provenanceSha256",
    "confirmation"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "packageVersion": { "const": "4.3.0" },
    "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "designDirectionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "designDirectionLabel": { "type": "string", "minLength": 1 },
    "strategyThesis": { "type": "string", "minLength": 1 },
    "previewThemeId": { "type": "string", "minLength": 1 },
    "showcaseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compositionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "huashuRunId": { "type": "string", "minLength": 1 },
    "huashuInvokedAt": { "type": "string", "format": "date-time" },
    "provenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "confirmation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "confirmed"] },
        "confirmedAt": { "type": ["string", "null"], "format": "date-time" },
        "confirmedBy": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
