{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edit-html-report.local/schemas/v4/coverage-map.schema.json",
  "title": "Source Coverage Map",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "order", "substantive", "status", "reportNodeIds"],
        "properties": {
          "status": { "enum": ["pending", "preserved", "merged", "omitted"] },
          "reportNodeIds": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
