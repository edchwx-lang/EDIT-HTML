{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edit-html-report.local/schemas/v5-content-bindings.schema.json",
  "title": "Huashu Content Provenance Bindings",
  "type": "object",
  "required": ["schemaVersion", "bindings", "coverage", "omissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contentId", "factIds", "sourceRefs", "tier", "editableKind"],
        "properties": {
          "contentId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
          "factIds": { "type": "array", "items": { "type": "string" } },
          "sourceRefs": { "type": "array", "items": { "type": "string" } },
          "tier": { "enum": ["main", "detail", "appendix"] },
          "editableKind": { "enum": ["text", "block", "image", "chart"] }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["kind", "overviewContentIds", "overviewSourceRefs", "focusEntities", "representedFocusEntityIds"],
      "properties": {
        "kind": { "enum": ["vertical-slice", "complete-site"] },
        "overviewContentIds": { "$ref": "#/$defs/nonEmptyIds" },
        "overviewSourceRefs": { "$ref": "#/$defs/nonEmptyIds" },
        "focusEntities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/focusEntity" }
        },
        "representedFocusEntityIds": { "$ref": "#/$defs/nonEmptyIds" }
      },
      "additionalProperties": false
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "reason", "authorizedBy", "authorizedAt"],
        "properties": {
          "sourceId": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "authorizedBy": { "const": "user" },
          "authorizedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "rawAppendixAuthorization": {
      "type": "object",
      "required": ["authorizedBy", "reason", "authorizedAt"],
      "properties": {
        "authorizedBy": { "const": "user" },
        "reason": { "type": "string", "minLength": 1 },
        "authorizedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonEmptyIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "facet": {
      "type": "object",
      "required": ["facetId", "label", "sourceRefs", "contentIds"],
      "properties": {
        "facetId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyIds" },
        "contentIds": { "$ref": "#/$defs/nonEmptyIds" }
      },
      "additionalProperties": false
    },
    "focusEntity": {
      "type": "object",
      "required": ["entityId", "label", "sourceRefs", "contentIds", "facets"],
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyIds" },
        "contentIds": { "$ref": "#/$defs/nonEmptyIds" },
        "facets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/facet" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
